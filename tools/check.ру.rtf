"""\
import asyncio\
import sys\
from pathlib import Path\
\
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\
import config  # noqa: E402\
from checker import Checker  # noqa: E402\
\
\
async def main(names: list[str]) -> None:\
    c = Checker()\
    await c.start()\
    print(f"\\n\uc0\u1058 \u1086 \u1095 \u1085 \u1072 \u1103  \u1087 \u1088 \u1086 \u1074 \u1077 \u1088 \u1082 \u1072  \u1095 \u1077 \u1088 \u1077 \u1079  \u1072 \u1082 \u1082 \u1072 \u1091 \u1085 \u1090 : \{'\u1042 \u1050 \u1051 \u1070 \u1063 \u1045 \u1053 \u1040 ' if c.tl else '\u1042 \u1067 \u1050 \u1051 \u1070 \u1063 \u1045 \u1053 \u1040  (\u1085 \u1080 \u1082 \u1080  \u1085 \u1077  \u1092 \u1080 \u1083 \u1100 \u1090 \u1088 \u1091 \u1102 \u1090 \u1089 \u1103 !)'\}\\n")\
    for name in names:\
        name = name.lstrip("@").lower()\
        tg = await c.tg_status(name)\
        frag = await c.fragment_status(name)\
        raw = "-"\
        if c.tl:\
            from telethon.tl.functions.account import CheckUsernameRequest\
            try:\
                raw = repr(await c.tl(CheckUsernameRequest(name)))\
            except Exception as ex:\
                raw = f"\{type(ex).__name__\}: \{ex\}"\
        res = await c.check(name, use_cache=False)\
        print(f"@\{name\}\\n  t.me: \{tg\}\\n  Fragment: \{frag\}\\n  checkUsername: \{raw\}\\n"\
              f"  \uc0\u1048 \u1058 \u1054 \u1043  \u1073 \u1086 \u1090 \u1072 : \{'\u1057 \u1042 \u1054 \u1041 \u1054 \u1044 \u1045 \u1053 ' if res.free else '\u1085 \u1077  \u1089 \u1074 \u1086 \u1073 \u1086 \u1076 \u1077 \u1085 '\} (tg=\{res.tg\}, frag=\{res.frag\})\\n")\
    await c.close()\
\
\
if len(sys.argv) < 2:\
    sys.exit("\uc0\u1055 \u1088 \u1080 \u1084 \u1077 \u1088 : python3 tools/check.py zoutu")\
